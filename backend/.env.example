# Application
APP_NAME=Curriculum Orthogonality Checker
APP_VERSION=1.0.0
DEBUG=false

# Auth — REQUIRED for production (DEBUG=false). The app refuses to start if this
# is left at the built-in default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value

# Admin bootstrap. Set both to provision an admin user at startup. In production
# this is the ONLY way to create an admin — the public /auth/register endpoint
# never grants admin, so there is no "first request wins admin" race.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# API rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT=60/minute
# Behind nginx/CapRover, derive the client IP from X-Forwarded-For so the limit
# is per-client and not collapsed onto the single proxy IP. Set to false only if
# the app is exposed directly with no trusted proxy in front.
RATE_LIMIT_TRUSTED_PROXY=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orthogonality
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/orthogonality

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# AI Model — multilingual is required for TR/EN cross-lingual comparison
MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_THRESHOLD=0.70

# Cross-encoder re-ranking (optional, slower but more precise).
# Validate the gain and tune RERANK_WEIGHT with:  python -m eval.benchmark --compare
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=30
RERANK_WEIGHT=0.5

# Scraper TLS verification. Default true (verify certificates). Set to false only
# if a university site with a broken cert chain causes its import to fail with
# SSL errors — disabling exposes scraped data to MITM.
SCRAPER_VERIFY_SSL=true

# Vector search backend: "pgvector" (default; multi-worker safe, needs the
# pgvector Postgres image). "memory" is an in-process numpy index used only by
# the eval harness (eval/benchmark.py) and is not a deployment option.
SEARCH_BACKEND=pgvector
EMBEDDING_DIM=384
